# Supabase project settings (Project Settings > API in the Supabase dashboard)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Set as a secret on the Supabase project for the generate-recap Edge Function.
# Do NOT prefix with VITE_ and never put this in client-side code.
# supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
